#usda 1.0

over "Root"
{
    over "Geometry"
    {
        over "Stars"
        {
            over "stars_01"
            {
                over "Stars"
                {
                    over "Star"
                    {
                        over "String"
                        {
                            over "String" (
                                prepend apiSchemas = ["MaterialBindingAPI"]
                            )
                            {
                                rel material:binding = </Root/Looks/Mirror>
                            }
                        }
                    }
                }
            }

